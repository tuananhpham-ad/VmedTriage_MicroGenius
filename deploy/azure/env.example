# Bien moi truong cho Azure Container Apps.
#
#   cp deploy/azure/env.example deploy/azure/env
#   # dien gia tri that vao deploy/azure/env (file nay da nam trong .gitignore)
#   ./scripts/deploy_azure.sh          # script tu doc file nay
#
# Dinh dang: KEY=value, moi dong mot bien, khong dau nhay bao quanh gia tri.

APP_ENV=production

# Thay bang URL that cua Container App sau lan deploy dau tien (script se in ra).
# Thieu PASSWORD_RESET_BASE_URL thi link dat lai mat khau gui cho nguoi dung tro ve localhost:8000.
PASSWORD_RESET_BASE_URL=https://vmedtriage.xxxxx.southeastasia.azurecontainerapps.io
CORS_ORIGINS=https://vmedtriage.xxxxx.southeastasia.azurecontainerapps.io

# Chuoi Neon, giu nguyen ?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
JWT_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai-hon-32-ky-tu
NURSE_REGISTRATION_CODE=ma-moi-rieng-cho-dieu-duong

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=ban@gmail.com
SMTP_PASSWORD=app-password-16-ky-tu
SMTP_FROM_EMAIL=ban@gmail.com

LLM_PROVIDER=auto
LLM_PROVIDER_ORDER=openrouter,deepseek,gemini,openai,anthropic
OPENROUTER_API_KEY=sk-or-xxx

# Graph triage: artifact da duoc nuong san vao image luc build (xem Dockerfile).
ENABLE_GRAPH_TRIAGE_AGENT=true
GRAPH_TRIAGE_ARTIFACT_ROOT=/app/runs

SOURCE_SUPPORT_ENABLED=true
TAVILY_API_KEY=tvly-xxx
