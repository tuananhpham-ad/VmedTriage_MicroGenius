# Bien moi truong cho Azure Container Apps.
#
#   cp deploy/azure/env.example deploy/azure/env
#   # dien gia tri that vao deploy/azure/env (file nay da nam trong .gitignore)
#   ./scripts/deploy_azure.sh          # script tu doc file nay
#
# Dinh dang: KEY=value, moi dong mot bien, khong dau nhay bao quanh gia tri.

APP_ENV=production

# Thay bang URL that cua Container App sau lan deploy dau tien (script se in ra).
# Thieu PASSWORD_RESET_BASE_URL thi link dat lai mat khau gui cho nguoi dung tro ve localhost:8000.
PASSWORD_RESET_BASE_URL=https://vmedtriage.xxxxx.southeastasia.azurecontainerapps.io
CORS_ORIGINS=https://vmedtriage.xxxxx.southeastasia.azurecontainerapps.io

# Chuoi Neon, giu nguyen ?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
JWT_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai-hon-32-ky-tu
NURSE_REGISTRATION_CODE=ma-moi-rieng-cho-dieu-duong

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=ban@gmail.com
SMTP_PASSWORD=app-password-16-ky-tu
SMTP_FROM_EMAIL=ban@gmail.com

LLM_PROVIDER=auto
LLM_PROVIDER_ORDER=openrouter,deepseek,gemini,openai,anthropic
OPENROUTER_API_KEY=sk-or-xxx

# Graph triage: artifact da duoc nuong san vao image luc build (xem Dockerfile).
ENABLE_GRAPH_TRIAGE_AGENT=true
# off = khong goi model graph. c6 = CHI Fusion (+ GPT direct + rule) - day la nhanh cho "AI de
# xuat" o man hinh dieu duong. ensemble = LogReg + PhoBERT + Fusion + LLM.
# Mac dinh trong src/config.py la "off", nen KHONG dat dong nay = khong co AI de xuat.
GRAPH_TRIAGE_MODE=c6
# GRAPH_TRIAGE_ARTIFACT_ROOT: DE TRONG. Dockerfile da ENV=/app/runs san trong image. Dat lai o
# day thi Git Bash (MSYS) dich thanh "C:/Program Files/Git/app/runs" -> Fusion khong nap duoc.

SOURCE_SUPPORT_ENABLED=true
TAVILY_API_KEY=tvly-xxx

# ---- Memory (F04) ----
# M1 (persist phien dang do) va M2 (nen context) KHONG co cong tac: chung chay mac dinh.
#
# M3 (ky uc xuyen phien - mo hoi thoai moi thi hoi tham phien truoc) TAT cho toi khi PM tra loi
# consent + retention bang van ban: xem _guidance/features/F04_memory.md muc 3 dieu kien 3. Day la
# du lieu y te cua nguoi benh song LAU HON phien sinh ra no, nen bat no la mot quyet dinh co nguoi
# ky chu khong phai mot mac dinh lot vao production kem mot lan deploy. Bat = doi thanh "true".
LONG_MEMORY_ENABLED=false

# Cho MODEL viet cau hoi tham thay vi doc cau tinh. Mac dinh bat, va no KHONG bat duoc M3 - tat ca
# van nam duoi LONG_MEMORY_ENABLED o tren. Moi duong that bai (tat co, model chet, truot guard cua
# followup_writer) deu roi ve dung cau tinh.
FOLLOWUP_QUESTION_LLM_ENABLED=true

# ---- Ghim model theo VAI TRO (de trong = ke thua LLM_PROVIDER_ORDER) ----
# Hai vai tro cua tang ky uc la HAI viec khac nhau, nen co hai bien rieng:
#   context_summary   - nen hoi thoai DANG chay, dau ra doc boi model o cung phien do
#   followup_question - viet cau hoi tham mo dau hoi thoai MOI, dau ra di THANG toi nguoi benh
# ROLE_ORDER_CONTEXT_SUMMARY=deepseek,openrouter
# ROLE_ORDER_FOLLOWUP_QUESTION=gemini,openrouter

# ---- Temperature theo VAI TRO (2026-08-25) ----
# temperature > 0 CHI danh cho vai tro ma dau ra la VAN PHONG. Vai tro nao dau ra la DU KIEN
# (field, nhan, claim, phan quyet) thi 0.0 - o do da dang khong phai "tu nhien hon", no la sai so.
#
# De TRONG cung duoc: src/config.py da co dung cac so nay lam mac dinh. Liet ke o day de nguoi
# dung moi doc duoc ma khong phai mo code, va de khong ai vo tinh chinh mot vai tro bang cach
# doi LLM_TEMPERATURE toan cuc (viec do doi luon MOI vai tro chua duoc liet ke).

# Dau ra la DU KIEN - phai tat dinh
ROLE_TEMPERATURE_FACT_EXTRACTOR=0.0
ROLE_TEMPERATURE_SYMPTOM_GROUP_ROUTER=0.0
ROLE_TEMPERATURE_CLAIM_SPLITTER=0.0
ROLE_TEMPERATURE_SOURCE_VERDICT=0.0
ROLE_TEMPERATURE_CONTEXT_SUMMARY=0.0

# Dau ra la VAN PHONG
ROLE_TEMPERATURE_SYNTHESIS=0.2
ROLE_TEMPERATURE_SOURCE_EXPLAIN=0.3
ROLE_TEMPERATURE_FOLLOWUP_QUESTION=0.3
ROLE_TEMPERATURE_CHITCHAT=0.7

# ---- Che PHI trong log giai doan + trace Braintrust ----
# 1 = thay user_message / agent_message / text / response_text / content bang {len, sha256_8}.
#     Cac truong khac GIU NGUYEN, ke ca `extracted` (field model trich ra) - nen van theo doi duoc
#     chat luong trich xuat, chi mat cau goc cua nguoi benh.
# 0 = nguyen van hoi thoai di len Braintrust.
#
# DANG DE 0 CO CHU DICH (2026-08-25): dang go loi "detect bia / trich sai trong tam", va viec do bat
# buoc phai doc duoc CAU NGUOI BENH GO ben canh field model trich ra. Che di thi biet model sai
# nhung khong biet vi sao sai.
#
# BAT LEN 1 TRUOC KHI CO BENH NHAN THAT. Khong co gi trong code canh ranh gioi nay ho ban.
FEVER_LOG_REDACT=0
